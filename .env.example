# Get testnet keys from https://testnet.binance.vision/
BINANCE_API_KEY=your_testnet_api_key
BINANCE_API_SECRET=your_testnet_api_secret

# Port for the health-check endpoint (Render sets this automatically, but 10000 is the default)
PORT=10000

# true = fake money, real prices. Set to false only when you're ready for real trading.
USE_TESTNET=true

# Comma-separated symbols to watch
WATCHLIST=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,DOGEUSDT

# Buy when price drops this % from the recent rolling high
DIP_THRESHOLD_PCT=2.0

# Sell when price rises this % above your buy price
SELL_TARGET_PCT=2.5

# USDT spent per trade (must clear exchange minimum, usually ~$5-10)
POSITION_SIZE_USDT=10

# How many price checks make up the "recent high" window
ROLLING_WINDOW=20

# Seconds between price checks
CHECK_INTERVAL_SEC=60

# --- Risk filters (v2) ---

# Sell and cut the loss if price falls this % below your buy price
STOP_LOSS_PCT=3.0

# Force-close a position after this many hours, win or lose, so nothing sits forever
MAX_HOLD_HOURS=24

# Only buy if RSI is below this (confirms the dip is actually oversold, not just noise)
RSI_PERIOD=14
RSI_OVERSOLD=35

# Skip buying if price is below its longer-term moving average (likely a downtrend, not a dip)
TREND_MA_PERIOD=50
TREND_FILTER_ENABLED=true

# Candle size used to calculate RSI and the trend moving average
KLINE_INTERVAL=15m

# --- v3: multi-position, volume confirmation, trailing stop ---

# Max number of coins the bot will hold at once (spreads risk instead of one big bet)
MAX_CONCURRENT_POSITIONS=3

# Only buy a dip if the latest candle's volume is meaningfully above its recent average
# (filters out low-liquidity noise dips that aren't backed by real activity)
VOLUME_FILTER_ENABLED=true
VOLUME_MA_PERIOD=20
VOLUME_MULTIPLIER=1.2

# Trailing stop: once a position gains past TRAILING_ACTIVATION_PCT, the stop trails
# behind the peak price instead of selling the instant SELL_TARGET_PCT is hit —
# lets real bounces run further while still locking in gains if it reverses.
TRAILING_STOP_ENABLED=true
TRAILING_ACTIVATION_PCT=1.5
TRAILING_STOP_PCT=1.0

# --- v4: ATR-adaptive thresholds + partial take-profit ---

# Instead of one fixed % for every coin, thresholds scale with each coin's own
# recent volatility (ATR). A calm coin gets tighter bands, a volatile one gets wider.
ATR_ENABLED=true
ATR_PERIOD=14
ATR_DIP_MULTIPLIER=1.0
ATR_TARGET_MULTIPLIER=1.5
ATR_STOP_MULTIPLIER=1.8
# Floors so a very quiet coin doesn't get unreasonably tiny thresholds
MIN_DIP_PCT=0.8
MIN_TARGET_PCT=1.0
MIN_STOP_PCT=1.5

# Sell part of the position once target is hit (locks in real profit), let the
# rest ride the trailing stop instead of exiting the whole position at once.
PARTIAL_TAKE_PROFIT_ENABLED=true
PARTIAL_TAKE_PROFIT_FRACTION=0.5

# --- v5: adaptive per-symbol learning (not ML — a transparent feedback loop) ---
# Each symbol gets its own multiplier based on its recent win/loss record.
# Trading a symbol well makes the bot slightly more willing to trade it again;
# trading it poorly makes entry conditions stricter until it proves itself.
# Check the dashboard's "Adaptive Per-Symbol Tuning" table to see this live.
ADAPTIVE_ENABLED=true
ADAPTIVE_LOOKBACK_TRADES=5
ADAPTIVE_STEP=0.1
ADAPTIVE_MIN_MULTIPLIER=0.7
ADAPTIVE_MAX_MULTIPLIER=1.5
